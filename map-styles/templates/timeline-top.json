{
  "version": 8,
  "name": "MapEx Template Timeline Top",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "omt": {
      "type": "vector",
      "url": "pmtiles://https://tiles.mapex.org/planet.pmtiles"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#10151d" } },
    { "id": "landcover", "type": "fill", "source": "omt", "source-layer": "landcover", "paint": { "fill-color": "#1d2a2e", "fill-opacity": 0.55 } },
    { "id": "landuse", "type": "fill", "source": "omt", "source-layer": "landuse", "paint": { "fill-color": "#1a232b", "fill-opacity": 0.55 } },
    { "id": "water", "type": "fill", "source": "omt", "source-layer": "water", "paint": { "fill-color": "#18354d" } },
    { "id": "waterway", "type": "line", "source": "omt", "source-layer": "waterway", "paint": { "line-color": "#3f6d8f", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 14, 2.1] } },
    { "id": "roads-main", "type": "line", "source": "omt", "source-layer": "transportation", "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]], "paint": { "line-color": "#6f5a46", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 13, 2.4, 16, 5], "line-opacity": 0.8 } },
    { "id": "roads-minor", "type": "line", "source": "omt", "source-layer": "transportation", "filter": ["in", ["get", "class"], ["literal", ["tertiary", "minor", "service", "track"]]], "paint": { "line-color": "#2a3643", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.25, 16, 1.8], "line-opacity": 0.9 } },
    { "id": "boundary", "type": "line", "source": "omt", "source-layer": "boundary", "filter": ["==", ["get", "admin_level"], 2], "paint": { "line-color": "#4f6274", "line-dasharray": [3, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.4, 8, 1.1], "line-opacity": 0.55 } },
    { "id": "place-country", "type": "symbol", "source": "omt", "source-layer": "place", "filter": ["==", ["get", "class"], "country"], "layout": { "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 2, 10, 6, 13], "text-transform": "uppercase" }, "paint": { "text-color": "#8ea8bc", "text-halo-color": "rgba(16,21,29,0.9)", "text-halo-width": 1 } },
    { "id": "place-city", "type": "symbol", "source": "omt", "source-layer": "place", "filter": ["in", ["get", "class"], ["literal", ["city", "town"]]], "minzoom": 4, "layout": { "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 10, 13], "text-offset": [0, 0.6], "text-anchor": "top" }, "paint": { "text-color": "#b3c7d6", "text-halo-color": "rgba(16,21,29,0.92)", "text-halo-width": 1.1 } }
  ]
}
{
  "version": 8,
  "name": "MapEx Template Default",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "omt": {
      "type": "vector",
      "url": "pmtiles://https://tiles.mapex.org/planet.pmtiles"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#eff2f4" } },
    { "id": "landcover", "type": "fill", "source": "omt", "source-layer": "landcover", "paint": { "fill-color": "#dce8d8", "fill-opacity": 0.45 } },
    { "id": "landuse", "type": "fill", "source": "omt", "source-layer": "landuse", "paint": { "fill-color": "#e8ece2", "fill-opacity": 0.5 } },
    { "id": "water", "type": "fill", "source": "omt", "source-layer": "water", "paint": { "fill-color": "#bad8ef" } },
    { "id": "waterway", "type": "line", "source": "omt", "source-layer": "waterway", "paint": { "line-color": "#9ec5e3", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.4, 14, 2.2] } },
    { "id": "roads-main", "type": "line", "source": "omt", "source-layer": "transportation", "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]], "paint": { "line-color": "#e4b998", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 13, 2.6, 16, 5.5], "line-opacity": 0.9 } },
    { "id": "roads-minor", "type": "line", "source": "omt", "source-layer": "transportation", "filter": ["in", ["get", "class"], ["literal", ["tertiary", "minor", "service", "track"]]], "paint": { "line-color": "#f2ede6", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.3, 16, 2.2] } },
    { "id": "boundary", "type": "line", "source": "omt", "source-layer": "boundary", "filter": ["==", ["get", "admin_level"], 2], "paint": { "line-color": "#808c9c", "line-dasharray": [3, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 8, 1.2], "line-opacity": 0.6 } },
    { "id": "place-country", "type": "symbol", "source": "omt", "source-layer": "place", "filter": ["==", ["get", "class"], "country"], "layout": { "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 2, 10, 6, 14], "text-transform": "uppercase" }, "paint": { "text-color": "#516070", "text-halo-color": "rgba(239,242,244,0.92)", "text-halo-width": 1.1 } },
    { "id": "place-city", "type": "symbol", "source": "omt", "source-layer": "place", "filter": ["in", ["get", "class"], ["literal", ["city", "town"]]], "minzoom": 4, "layout": { "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 10, 14], "text-offset": [0, 0.6], "text-anchor": "top" }, "paint": { "text-color": "#354454", "text-halo-color": "rgba(239,242,244,0.95)", "text-halo-width": 1.2 } }
  ]
}
{
  "version": 8,
  "name": "MapEx Template Atlas Dock",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "omt": {
      "type": "vector",
      "url": "pmtiles://https://tiles.mapex.org/planet.pmtiles"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f3efe8" } },
    { "id": "landcover", "type": "fill", "source": "omt", "source-layer": "landcover", "paint": { "fill-color": "#d8dfcc", "fill-opacity": 0.46 } },
    { "id": "landuse", "type": "fill", "source": "omt", "source-layer": "landuse", "paint": { "fill-color": "#e6e1d4", "fill-opacity": 0.55 } },
    { "id": "water", "type": "fill", "source": "omt", "source-layer": "water", "paint": { "fill-color": "#adcbe0" } },
    { "id": "waterway", "type": "line", "source": "omt", "source-layer": "waterway", "paint": { "line-color": "#84aec8", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.4, 14, 2.2] } },
    { "id": "roads-main", "type": "line", "source": "omt", "source-layer": "transportation", "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]], "paint": { "line-color": "#b18363", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 13, 2.6, 16, 5.5], "line-opacity": 0.88 } },
    { "id": "roads-minor", "type": "line", "source": "omt", "source-layer": "transportation", "filter": ["in", ["get", "class"], ["literal", ["tertiary", "minor", "service", "track"]]], "paint": { "line-color": "#f4ede1", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.3, 16, 2.2], "line-opacity": 0.95 } },
    { "id": "building", "type": "fill", "source": "omt", "source-layer": "building", "minzoom": 13, "paint": { "fill-color": "#d7c8b7", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0.2, 16, 0.62] } },
    { "id": "boundary", "type": "line", "source": "omt", "source-layer": "boundary", "filter": ["==", ["get", "admin_level"], 2], "paint": { "line-color": "#8d867a", "line-dasharray": [3, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 8, 1.2], "line-opacity": 0.62 } },
    { "id": "place-country", "type": "symbol", "source": "omt", "source-layer": "place", "filter": ["==", ["get", "class"], "country"], "layout": { "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 2, 10, 6, 14], "text-transform": "uppercase" }, "paint": { "text-color": "#5f5a51", "text-halo-color": "rgba(243,239,232,0.95)", "text-halo-width": 1.1 } },
    { "id": "place-city", "type": "symbol", "source": "omt", "source-layer": "place", "filter": ["in", ["get", "class"], ["literal", ["city", "town"]]], "minzoom": 4, "layout": { "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 10, 14], "text-offset": [0, 0.6], "text-anchor": "top" }, "paint": { "text-color": "#3f484f", "text-halo-color": "rgba(243,239,232,0.95)", "text-halo-width": 1.1 } }
  ]
}
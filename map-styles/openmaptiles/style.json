{
  "version": 8,
  "name": "MapEx OpenMapTiles Light",
  "metadata": {
    "mapex:profile": "openmaptiles-light"
  },
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "omt": {
      "type": "vector",
      "url": "pmtiles://https://tiles.mapex.org/planet.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#edf1f5"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "omt",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": {
        "fill-color": "#d7e8d1",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "omt",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "grass"],
      "paint": {
        "fill-color": "#e4efd8",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "omt",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "park", "#dcefd5",
          "cemetery", "#d8e9d1",
          "industrial", "#ebeaec",
          "residential", "#f0eef0",
          "#eceff2"
        ],
        "fill-opacity": 0.55
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "omt",
      "source-layer": "water",
      "paint": {
        "fill-color": "#b9d8f0"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "omt",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#9ec8e8",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6, 0.4,
          12, 1.1,
          16, 2.4
        ]
      }
    },
    {
      "id": "aeroway",
      "type": "line",
      "source": "omt",
      "source-layer": "aeroway",
      "minzoom": 10,
      "paint": {
        "line-color": "#d3d7dd",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 0.8,
          16, 4
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary"]]],
      "paint": {
        "line-color": [
          "match",
          ["get", "class"],
          "motorway", "#dc9d7a",
          "trunk", "#e2ab86",
          "primary", "#e9bc97",
          "#efcfaa"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 0.4,
          9, 1.3,
          13, 2.8,
          16, 5.8
        ],
        "line-opacity": 0.92
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["tertiary", "minor", "service", "track"]]],
      "paint": {
        "line-color": "#f2eee8",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 0.3,
          13, 1.1,
          16, 2.5
        ],
        "line-opacity": 0.95
      }
    },
    {
      "id": "roads-rail",
      "type": "line",
      "source": "omt",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "rail"],
      "paint": {
        "line-color": "#a9b1bb",
        "line-dasharray": [2, 2],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 0.4,
          16, 2
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "omt",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d9d2c9",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13, 0.2,
          16, 0.65
        ]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "omt",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#8a95a4",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3, 0.5,
          8, 1.3
        ],
        "line-dasharray": [4, 2],
        "line-opacity": 0.6
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "omt",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#9ca6b3",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4, 0.3,
          9, 0.9
        ],
        "line-dasharray": [2, 2],
        "line-opacity": 0.45
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "omt",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2, 10,
          6, 14
        ],
        "text-letter-spacing": 0.05,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#516070",
        "text-halo-color": "rgba(237, 241, 245, 0.9)",
        "text-halo-width": 1.1
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "omt",
      "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town"]]],
      "minzoom": 4,
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4, 10,
          10, 14,
          14, 16
        ],
        "text-offset": [0, 0.6],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#364454",
        "text-halo-color": "rgba(237, 241, 245, 0.95)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "road-name",
      "type": "symbol",
      "source": "omt",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#8a7865",
        "text-halo-color": "rgba(255, 255, 255, 0.9)",
        "text-halo-width": 1
      }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "omt",
      "source-layer": "water_name",
      "minzoom": 5,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5, 10,
          10, 13
        ]
      },
      "paint": {
        "text-color": "#4b7da7",
        "text-halo-color": "rgba(237, 241, 245, 0.85)",
        "text-halo-width": 0.8
      }
    }
  ]
}
